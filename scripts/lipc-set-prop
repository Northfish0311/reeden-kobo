#!/bin/sh
# During pre-render warmup Nickel owns the hardware. Do not change its light.
[ -n "${REEDEN_KOBO_DIR:-}" ] && [ -f "$REEDEN_KOBO_DIR/state/handoff" ] || exit 69
while [ "$#" -gt 3 ]; do shift; done
[ "$#" = 3 ] || exit 64
case "$1:$2:$3" in
  com.lab126.cmd:wirelessEnable:0|com.lab126.wifid:enable:0)
    exec "$REEDEN_KOBO_DIR/wifi.sh" off;;
  com.lab126.cmd:wirelessEnable:1|com.lab126.wifid:enable:1)
    exec "$REEDEN_KOBO_DIR/wifi.sh" on;;
esac
[ "$1" = com.lab126.powerd ] || exit 69
[ ! -f "$REEDEN_KOBO_DIR/state/asleep" ] && [ ! -d "$REEDEN_KOBO_DIR/state/recovering" ] || exit 69
case "$3" in ''|*[!0-9]*) exit 64;; esac
case "$2" in
  flIntensity)
    [ "$3" -le 24 ] || exit 64
    level=$((($3 * 100 + 12) / 24))
    echo "$level" > /sys/class/backlight/mxc_msp430.0/brightness || exit 1
    [ -z "${REEDEN_CHOICES:-}" ] || echo "$level" > "$REEDEN_CHOICES/brightness"
    ;;
  currentAmberLevel)
    [ "$3" -le 24 ] || exit 64
    raw=$((10 - ($3 * 10 + 12) / 24))
    echo "$raw" > /sys/class/backlight/lm3630a_led/color || exit 1
    [ -z "${REEDEN_CHOICES:-}" ] || echo "$raw" > "$REEDEN_CHOICES/warmth"
    if [ -d "$REEDEN_KOBO_DIR/userdata" ]; then
      printf 'warmth=%d\n' $(((10 - raw) * 10)) > "$REEDEN_KOBO_DIR/userdata/kobo-light.conf.tmp" && \
        mv -f "$REEDEN_KOBO_DIR/userdata/kobo-light.conf.tmp" "$REEDEN_KOBO_DIR/userdata/kobo-light.conf"
    fi
    ;;
  *)
    echo "Unsupported Kobo power property: $2" >&2
    exit 69
    ;;
esac
